# ~/.config/minimax-studio/env on the Ubuntu node (mode 600).
# Only the tunnel reaches the studio, so it listens on loopback but still requires the login.
HOST=127.0.0.1
MINIMAX_STUDIO_PORT=8795
MINIMAX_STUDIO_REQUIRE_AUTH=1
MINIMAX_STUDIO_NO_OPEN=1
# GaiaNAS is the server's own disk: audio/ images/ videos/ final/ live here.
MINIMAX_ASSETS_ROOT=/mnt/gaia/production_assets
COMFYUI_OUTPUT_DIR=/home/bakhtiarrifai/ComfyUI/output
# The password is generated on first start into ~/.config/minimax-studio/password (user "studio").
# MINIMAX_STUDIO_PASSWORD=...   # or set it here instead
