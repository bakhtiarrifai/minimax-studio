# ~/.config/minimax-studio/env on the Ubuntu node (mode 600).
# Only the Cloudflare tunnel reaches the studio, so it listens on loopback.
HOST=127.0.0.1
MINIMAX_STUDIO_PORT=8795
MINIMAX_STUDIO_NO_OPEN=1
# The only login is Cloudflare Access, like the other *.upgradingu.com sites. The studio still checks the signed
# Access token on every request (team name + the application's AUD tag from Zero Trust -> Access -> Applications).
MINIMAX_STUDIO_ACCESS_TEAM=upgradingu
MINIMAX_STUDIO_ACCESS_AUD=<application AUD tag>
# GaiaNAS is the server's own disk: audio/ images/ videos/ final/ live here.
MINIMAX_ASSETS_ROOT=/mnt/gaia/production_assets
COMFYUI_OUTPUT_DIR=/home/bakhtiarrifai/ComfyUI/output
# Without Access (e.g. LAN only), drop the two ACCESS lines and set MINIMAX_STUDIO_REQUIRE_AUTH=1 for a Basic login.
